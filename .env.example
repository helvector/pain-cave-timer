# Copy to .env.local for local dev. Real values live ONLY in Vercel environment variables.
# Never commit .env.local — this repo is public.

# Mailbox the TrainingPeaks daily schedule emails arrive in (IMAP)
MAIL_HOST=imap.example.com
MAIL_PORT=993
MAIL_USER=you@example.com
MAIL_PASSWORD=app-specific-password
# Only messages from this sender are considered workout emails
MAIL_FROM=messages-no-reply@trainingpeaks.com

# Your current FTP in watts. Only needed if the coach writes targets as %FTP;
# TrainingPeaks emails normally arrive with absolute watts already.
FTP_WATTS=250

# Shared secret required to hit the fetch endpoint (the deployed app is public)
APP_TOKEN=change-me
