# Copy to .env.local for local dev. Real values live ONLY in Vercel environment variables.
# Never commit .env.local — this repo is public.

# Mailbox the TrainingPeaks daily schedule emails arrive in (IMAP)
MAIL_HOST=imap.example.com
MAIL_PORT=993
MAIL_USER=you@example.com
MAIL_PASSWORD=app-specific-password
# Gmail: MAIL_HOST=imap.gmail.com with an App Password (needs 2-step verification).
# MAIL_SECURE=true and MAIL_FOLDER=INBOX are the defaults.
# Only messages from this sender are considered workout emails
MAIL_FROM=messages-no-reply@trainingpeaks.com

# IANA time zone used to decide what "today" is (Vercel runs in UTC)
APP_TIMEZONE=America/Los_Angeles

# Your current FTP in watts. Only needed if the coach writes targets as %FTP;
# TrainingPeaks emails normally arrive with absolute watts already.
FTP_WATTS=250
# Your threshold heart rate in BPM. Turns the coach's "84-92% of THR" notes into
# a live target range when a heart-rate sensor (e.g. Whoop broadcast) is connected.
THR_BPM=165

# Shared secret required to hit the fetch endpoint (the deployed app is public)
APP_TOKEN=change-me

# Private Vercel Blob store for the /admin settings (zones, colours, heart-rate range).
# Added automatically when you connect a Blob store to the project.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_placeholder

# Shared secret Vercel Cron sends to /api/cron/refresh, which saves the newest
# emails so page loads don't open the mailbox. Optional: without it every load reads IMAP.
CRON_SECRET=change-me
